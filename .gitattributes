* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.npz binary

# V19 evaluation artifacts are byte-addressed by frozen receipts and locks.
# Preserve their exact bytes instead of normalizing line endings.
data/evaluation/v19/** -text
